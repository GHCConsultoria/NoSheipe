# Supabase Auth — usado só como serviço de autenticação (login/signup do
# nutricionista via GoTrue). Os dados da aplicação NÃO ficam no Supabase,
# ficam no Turso (abaixo).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Usada em src/lib/supabase/admin.ts para o cadastro self-service do
# nutricionista. Nunca expor no cliente — só em código server-side.
SUPABASE_SERVICE_ROLE_KEY=""

# Banco da aplicação (Turso/libSQL) — schema em prisma/nutri/schema.prisma,
# client em src/lib/nutri/prisma.ts. Criar com a Turso CLI:
#   turso db create nosheipe
#   turso db show nosheipe --url          -> TURSO_DATABASE_URL
#   turso db tokens create nosheipe        -> TURSO_AUTH_TOKEN
# Depois: npm run db:push:nutri && npm run db:seed:nutri
# (isso também roda automaticamente durante o build quando as duas
# variáveis abaixo estão configuradas — ver package.json)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Extração de macros por IA. Dois provedores suportados; sem preferência
# explícita, Groq vem primeiro por ser o de tier GRATUITO. Basta uma chave.
# Sem nenhuma, o registro de refeição retorna um erro claro em vez de fingir
# uma resposta (ver src/lib/ia/provedor.ts).
#
# Groq (grátis — https://console.groq.com/keys):
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
#
# Anthropic (pago — https://console.anthropic.com), reserva opcional:
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
#
# Força um provedor específico ("groq" ou "anthropic"); em branco = automático.
IA_PROVEDOR=""

# Move os clientes de exemplo do "Profissional Demo" pra uma conta real,
# pra o painel não abrir vazio depois que o Supabase entra em jogo. Sem a
# variável, os exemplos ficam com o demo (ver prisma/nutri/seed.ts).
DONO_DEMO_EMAIL=""

# Acesso à interface administrativa (/master), separado por vírgula. É
# concessão manual de propósito: não existe tela que promova alguém a
# master, então não existe caminho de escalada de privilégio pelo app.
# O seed só concede — revogar se faz no banco, deliberadamente.
MASTER_EMAILS=""

# Popula o banco com profissionais e clientes de placeholder, pra o painel
# administrativo abrir com volume em vez de meia dúzia de linhas. Só tem
# efeito com o valor exato "true", e é idempotente: rodar de novo não
# empilha registros. Deixe vazio em ambiente de verdade.
SEED_POPULACAO_DEMO=""
