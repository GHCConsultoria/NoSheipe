// Schema separado do módulo NoSheipe — banco próprio (Turso/libSQL), distinto
// do Postgres/Supabase do sistema jurídico em ../schema.prisma. Os dois
// produtos vivem no mesmo repositório mas não compartilham banco nem client
// Prisma; ver src/lib/nutri/prisma.ts.

generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  // "native" cobre a máquina de desenvolvimento; "rhel-openssl-3.0.x" é o
  // runtime das funções serverless da Vercel. Sem ele o build passa, mas em
  // produção o client falha em runtime com "could not locate the Query
  // Engine" — o driver adapter troca o driver do banco, não o engine.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  // SQLite é o dialeto do Turso (libSQL) — a conexão de verdade em runtime
  // usa o client libSQL + adapter (ver src/lib/nutri/prisma.ts), não esta
  // URL diretamente; ela só precisa existir pro `prisma db push` da CLI.
  provider = "sqlite"
  url      = env("TURSO_DATABASE_URL")
}

/// Profissional unificado — substitui Nutricionista e PersonalTrainer, que
/// eram cópias uma da outra. Um profissional pode ser nutricionista,
/// personal, ou os dois: as capacidades é que decidem o que ele consegue
/// prescrever e o que aparece no painel dele.
///
/// Nutricionista/PersonalTrainer continuam no schema por enquanto para não
/// destruir as linhas antigas (nenhuma exclusão física — ver CLAUDE.md);
/// nenhum código novo os lê. Serão removidos numa limpeza posterior.
model Profissional {
  id String @id @default(cuid())

  // id do usuário no Supabase Auth (auth.users.id) — mesmo padrão dos
  // models que este substitui.
  authUserId String @unique
  nome       String
  email      String @unique

  // Capacidades. Pelo menos uma precisa ser true (validado em
  // src/lib/profissional/schemas.ts — SQLite não tem CHECK constraint útil
  // via Prisma).
  ehNutricionista Boolean @default(false)
  ehPersonal      Boolean @default(false)

  crn  String? // registro profissional, só faz sentido com ehNutricionista
  cref String? // idem, com ehPersonal

  // Limite do plano demo, mesma trava de quantidade de antes.
  limitePlano Int @default(20)

  // Acesso à interface administrativa (/master). Concedido só manualmente
  // no banco — de propósito não existe tela que promova alguém a master.
  ehMaster Boolean @default(false)

  vinculos  Vinculo[]
  anotacoes Anotacao[]
  recados   Recado[]
  templates Template[]

  // Obsoletos: donos da era Paciente/Aluno, antes do Cliente unificado.
  pacientes Paciente[]
  alunos    Aluno[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("profissionais")
}

// --- Cliente unificado ---
// Paciente e Aluno eram pessoas separadas, com links de acesso diferentes:
// quem tinha nutricionista E personal recebia dois links e usava dois apps.
// Cliente é a pessoa, uma só, com um link só — é o que permite a tela de
// progresso combinado (dieta e treino juntos) em /p/[token].

model Cliente {
  id String @id @default(cuid())

  nome     String
  telefone String?

  // Token opaco do link público (/p/[token]) — acesso sem senha.
  tokenAcesso String @unique

  // Código curto que o cliente passa pra um profissional novo poder pedir
  // vínculo. Diferente de tokenAcesso: este pode ser dito em voz alta sem
  // dar acesso à conta (ver fluxo de convite na Fase 3).
  codigoConvite String @unique

  // LGPD: null até aceitar o consentimento na primeira visita.
  consentimentoEm DateTime?

  // Valores válidos: "ATIVO" | "ARQUIVADO".
  status String @default("ATIVO")

  // --- Anamnese comum aos dois nichos ---
  // Data de nascimento, nunca idade: idade vira dado errado sozinha.
  dataNascimento DateTime?
  // "F" | "M" | "OUTRO"
  sexo           String?
  alturaCm       Int?
  objetivo       String?

  // Meta diária de água, em ml. É do cliente (hidratação não se prescreve),
  // então ele ajusta na própria página; 2000ml é só o ponto de partida.
  metaAguaMl Int @default(2000)

  vinculos            Vinculo[]
  planosNutricionais  PlanoNutricional[]
  treinos             TreinoPrescrito[]
  refeicoes           Refeicao[]
  sessoesTreino       SessaoTreino[]
  medidas             Medida[]
  registrosAgua       RegistroAgua[]
  anotacoes           Anotacao[]
  recados             Recado[]
  inscricoesPush      PushSubscription[]
  favoritos           Favorito[]
  anamneseNutricional AnamneseNutricional?
  anamneseTreino      AnamneseTreino?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("clientes")
}

/// Quem atende quem, e em quê. É isto que permite a nutricionista Ana e o
/// personal Bruno atenderem a mesma pessoa sem um enxergar a parte do
/// outro: toda consulta do profissional filtra por vínculo ativo do tipo
/// dele.
model Vinculo {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId String

  // Valores válidos: "NUTRICAO" | "TREINO".
  tipo   String
  // "PENDENTE" (aguardando o cliente aceitar) | "ATIVO" | "ENCERRADO".
  // Nunca exclusão física: encerrar é mudança de status.
  status String @default("ATIVO")

  criadoEm DateTime  @default(now())
  aceitoEm DateTime?

  // Um cliente tem no máximo um nutricionista e um personal — mas essa
  // regra vale só entre vínculos VIVOS (PENDENTE/ATIVO). Um @@unique
  // simples em [clienteId, tipo] obrigaria a sobrescrever a linha quando
  // um profissional substitui outro, apagando o registro de que o
  // anterior existiu. O índice fica em init.sql como índice parcial
  // ("WHERE status <> 'ENCERRADO'"), que o Prisma não sabe declarar.
  //
  // Consequência: não existe findUnique por [clienteId, tipo] — as
  // consultas usam findFirst filtrando por status.
  @@index([clienteId, tipo])
  @@map("vinculos")
}

/// Metas nutricionais, versionadas como TreinoPrescrito — trocar a meta
/// preserva a anterior, dando histórico da prescrição.
model PlanoNutricional {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  metaKcal     Int
  metaProteina Int
  metaCarbo    Int
  metaGordura  Int

  ativo Boolean @default(true)

  criadoEm DateTime @default(now())

  @@map("planos_nutricionais")
}

model TreinoPrescrito {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  nome          String
  // Texto livre com os exercícios — mesmo nível de detalhe que o resto do
  // domínio usa pra prescrição, sem parsing estruturado.
  descricao     String
  diasPorSemana Int
  ativo         Boolean @default(true)

  criadoEm DateTime @default(now())

  @@map("treinos_prescritos")
}

model Refeicao {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  // UUID gerado pelo client — dedupe idempotente.
  clienteRegistroId String @unique

  // "AUDIO" | "TEXTO"
  origem       String
  entradaBruta String
  // SQLite/Turso não suporta o tipo Json do Prisma — serializado à mão.
  // [{ nome, gramas, kcal, proteina, carbo, gordura }]
  itens        String

  kcal      Int
  proteina  Int
  carbo     Int
  gordura   Int
  // 0..1 devolvido pela IA — estimativa, nunca fato; rotulado na UI.
  confianca Float

  // Registro não fica refém da IA: quando o provedor de macros está fora
  // (sem cota, sem chave, fora do ar), a refeição é salva mesmo assim com os
  // macros zerados e esta flag ligada. A UI mostra "a estimar" e oferece
  // re-tentar — nunca chuta um número. Some quando a estimativa entra.
  macrosPendentes Boolean @default(false)

  // A pessoa corrigiu os macros na mão (a IA estimou perto, mas não exato).
  // A UI mostra "ajustado por você" em vez de "estimativa X%" — o número é
  // dela, não da IA. "O sistema propõe, o humano confirma."
  ajustadoManualmente Boolean @default(false)

  registradoEm DateTime @default(now())

  // Nunca exclusão física: uma refeição registrada errada (a IA estimou
  // mal, ou o cliente descreveu outra coisa) é removida marcando aqui a
  // hora. A linha fica; some de toda leitura via a extensão em prisma.ts.
  removidoEm DateTime?

  @@map("refeicoes")
}

model SessaoTreino {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  clienteRegistroId String @unique

  // "AUDIO" | "TEXTO"
  origem       String
  entradaBruta String

  realizadoEm DateTime @default(now())

  // Simétrico a Refeicao — o cliente pode ter marcado um treino que não fez.
  removidoEm DateTime?

  @@map("sessoes_treino")
}

model Medida {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  pesoKg Float

  registradoEm DateTime @default(now())

  @@map("medidas")
}

/// Copo d'água que o cliente registrou. Um toque = uma linha, para o total
/// do dia sair de uma soma (nunca de um contador guardado, que dessincroniza).
/// Métrica auto-relatada e efêmera — desfazer um toque errado é DELETE de
/// verdade, ao contrário de refeição/peso, que são registro clínico.
model RegistroAgua {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  ml Int

  registradoEm DateTime @default(now())

  @@map("registros_agua")
}

/// Anotação privada do profissional sobre o cliente. Guarda profissionalId
/// porque com clientes compartilhados a anotação da Ana não pode aparecer
/// pro Bruno. Só-adição, sem editar nem apagar.
model Anotacao {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId String

  texto String

  criadoEm DateTime @default(now())

  @@map("anotacoes")
}

/// Recado do profissional PARA o cliente — o outro lado da anotação, que é
/// privada. O cliente vê na home; guarda profissionalId pra mostrar quem
/// mandou e pra o profissional ver o histórico do que enviou. lidoEm marca
/// quando o cliente abriu, pro profissional saber se chegou.
model Recado {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId String

  texto  String
  lidoEm DateTime?

  criadoEm DateTime @default(now())

  @@index([clienteId])
  @@map("recados")
}

/// Modelo de prescrição salvo pelo profissional pra reusar em vários
/// clientes — uma dieta ou treino "de prateleira". É do profissional, não
/// do cliente; aplicar um template só preenche o formulário, a prescrição
/// de verdade continua sendo TreinoPrescrito/PlanoNutricional. Ferramenta
/// de conveniência, sem histórico clínico, então pode ser removido de fato.
model Template {
  id String @id @default(cuid())

  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId String

  // "NUTRICAO" | "TREINO" — decide quais campos abaixo valem.
  tipo String
  nome String

  // Preenchidos quando tipo = NUTRICAO.
  metaKcal     Int?
  metaProteina Int?
  metaCarbo    Int?
  metaGordura  Int?

  // Preenchidos quando tipo = TREINO.
  descricao     String?
  diasPorSemana Int?

  criadoEm DateTime @default(now())

  @@index([profissionalId, tipo])
  @@map("templates")
}

/// Inscrição de Web Push de UM aparelho do cliente (o mesmo cliente pode ter
/// vários: celular, tablet). endpoint é a chave natural que o navegador dá;
/// p256dh/auth são as chaves de cifragem da mensagem. Não é dado de negócio
/// — expira sozinho e é recriado, então some de verdade quando o navegador
/// avisa que morreu (404/410).
model PushSubscription {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  endpoint String @unique
  p256dh   String
  auth     String

  criadoEm DateTime @default(now())

  @@index([clienteId])
  @@map("push_subscriptions")
}

/// Atalho de conveniência do cliente — não é registro de negócio, então
/// pode ser removido de verdade.
model Favorito {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String

  descricao String

  criadoEm DateTime @default(now())

  @@map("favoritos")
}

/// Anamnese do lado da nutrição. Separada da de treino para o isolamento
/// entre profissionais valer também aqui: o personal não lê isto.
model AnamneseNutricional {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String  @unique

  jaSeguiuDieta         Boolean?
  restricoesAlimentares String?
  usaSuplemento         Boolean?
  refeicoesPorDia       Int?
  // "NUNCA" | "SOCIAL" | "FREQUENTE"
  consumoAlcool         String?
  observacoes           String?

  atualizadoEm DateTime @updatedAt

  @@map("anamnese_nutricional")
}

/// Anamnese do lado do treino — o nutricionista não lê isto.
model AnamneseTreino {
  id String @id @default(cuid())

  cliente   Cliente @relation(fields: [clienteId], references: [id])
  clienteId String  @unique

  // "INICIANTE" | "INTERMEDIARIO" | "AVANCADO"
  experiencia         String?
  // Dado sensível: direciona a prescrição.
  lesoesLimitacoes    String?
  frequenciaAtual     Int?
  praticaOutroEsporte String?
  observacoes         String?

  atualizadoEm DateTime @updatedAt

  @@map("anamnese_treino")
}

/// Obsoleto: substituído por Profissional. Mantido só para não apagar as
/// linhas existentes; nenhum código novo lê deste model.
model Nutricionista {
  id String @id @default(cuid())

  // id do usuário no Supabase Auth (auth.users.id) — continuamos usando o
  // Supabase só como serviço de autenticação (GoTrue), independente de
  // onde os dados da aplicação ficam guardados.
  authUserId  String  @unique
  nome        String
  email       String  @unique
  crn         String?
  // Limite do plano demo (R$ 99,90) — sem gateway de pagamento neste MVP,
  // só a trava de quantidade em criarPaciente.
  limitePlano Int     @default(20)

  pacientes Paciente[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("nutricionistas")
}

model Paciente {
  id String @id @default(cuid())

  // Dono atual. Nullable só porque SQLite não permite adicionar coluna NOT
  // NULL a uma tabela que já tem linhas — todo código novo sempre preenche,
  // e as consultas filtram por ele.
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  profissionalId String?

  // Obsoleto: dono antigo, antes da unificação em Profissional. Mantido
  // para não perder o vínculo histórico; nenhum código novo lê.
  nutricionista   Nutricionista @relation(fields: [nutricionistaId], references: [id])
  nutricionistaId String

  nome     String
  telefone String?

  // Token opaco do link público (/p/[token]) — acesso do paciente sem senha.
  tokenAcesso String @unique

  metaKcal     Int
  metaProteina Int
  metaCarbo    Int
  metaGordura  Int

  // LGPD: null até o paciente aceitar o consentimento na primeira visita à
  // própria página — sem isso o registro de refeição não libera.
  consentimentoEm DateTime?

  // SQLite/Turso não tem enum nativo — Prisma recusa `enum` neste provider.
  // Valores válidos: "ATIVO" | "ARQUIVADO" (ver src/lib/nutri/schemas.ts).
  status String @default("ATIVO")

  registros          RegistroRefeicao[]
  registrosMedida    RegistroMedida[]
  anotacoes          AnotacaoPaciente[]
  refeicoesFavoritas RefeicaoFavorita[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pacientes")
}

model RegistroRefeicao {
  id String @id @default(cuid())

  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId String

  // UUID gerado pelo client — dedupe idempotente (reprocessar o mesmo envio
  // nunca duplica o registro).
  clienteRegistroId String @unique

  // Valores válidos: "AUDIO" | "TEXTO" — ver nota de enum acima.
  origem       String
  entradaBruta String // texto digitado ou transcrição do áudio
  // SQLite/Turso não suporta o tipo Json do Prisma — serializado manualmente
  // (ver src/app/api/nutri/registros/route.ts). Formato:
  // [{ nome, gramas, kcal, proteina, carbo, gordura }]
  itens        String

  kcal      Int
  proteina  Int
  carbo     Int
  gordura   Int
  // 0..1 devolvido pela IA — é estimativa, nunca fato; rotulado como tal na UI.
  confianca Float

  registradoEm DateTime @default(now())
  criadoEm     DateTime @default(now())

  @@map("registros_refeicao")
}

// Peso auto-relatado pelo paciente em /p/[token] — separado de
// RegistroRefeicao porque nem todo check-in tem peso, e vira gráfico de
// evolução na visão do nutricionista (ver src/lib/nutri/consultas.ts).
model RegistroMedida {
  id String @id @default(cuid())

  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId String

  pesoKg Float

  registradoEm DateTime @default(now())
  criadoEm     DateTime @default(now())

  @@map("registros_medida")
}

// Anotação privada do nutricionista sobre o paciente (ex.: observação de
// consulta) — só-adição, sem edição/remoção, mesmo espírito de auditoria
// simples do resto do domínio.
model AnotacaoPaciente {
  id String @id @default(cuid())

  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId String

  texto String

  criadoEm DateTime @default(now())

  @@map("anotacoes_paciente")
}

// Atalho de conveniência pro paciente reaproveitar uma descrição de
// refeição já digitada antes — não é registro de negócio/auditoria (ao
// contrário de RegistroRefeicao), então pode ser removido de verdade.
model RefeicaoFavorita {
  id String @id @default(cuid())

  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  pacienteId String

  descricao String

  criadoEm DateTime @default(now())

  @@map("refeicoes_favoritas")
}

// --- Módulo de personal trainer ---

/// Obsoleto: substituído por Profissional (que cobre nutricionista e
/// personal na mesma tabela). Mantido só para não apagar as linhas
/// existentes; nenhum código novo lê deste model.
model PersonalTrainer {
  id String @id @default(cuid())

  authUserId  String  @unique
  nome        String
  email       String  @unique
  cref        String?
  // Mesmo padrão de limite de plano demo do Nutricionista.
  limitePlano Int     @default(20)

  alunos Aluno[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("personal_trainers")
}

model Aluno {
  id String @id @default(cuid())

  // Dono atual — ver nota sobre nullable em Paciente.profissionalId.
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  profissionalId String?

  // Obsoleto: dono antigo, antes da unificação em Profissional.
  personalTrainer   PersonalTrainer @relation(fields: [personalTrainerId], references: [id])
  personalTrainerId String

  nome     String
  telefone String?

  // Token opaco do link público (/t/[token]) — acesso do aluno sem senha.
  tokenAcesso String @unique

  // LGPD: null até o aluno aceitar o consentimento na primeira visita.
  consentimentoEm DateTime?

  // Valores válidos: "ATIVO" | "ARQUIVADO" (ver src/lib/personal/schemas.ts).
  status String @default("ATIVO")

  treinos   Treino[]
  registros RegistroTreino[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("alunos")
}

model Treino {
  id String @id @default(cuid())

  aluno   Aluno  @relation(fields: [alunoId], references: [id])
  alunoId String

  nome          String
  // Texto livre com os exercícios prescritos — mesmo nível de detalhe que
  // o resto do domínio usa pra "prescrição" (sem parsing estruturado).
  descricao     String
  diasPorSemana Int
  ativo         Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("treinos")
}

model RegistroTreino {
  id String @id @default(cuid())

  aluno   Aluno  @relation(fields: [alunoId], references: [id])
  alunoId String

  // UUID gerado pelo client — dedupe idempotente, mesmo padrão de
  // RegistroRefeicao.
  clienteRegistroId String @unique

  // Valores válidos: "AUDIO" | "TEXTO".
  origem       String
  entradaBruta String // texto digitado ou transcrição do áudio

  realizadoEm DateTime @default(now())
  criadoEm    DateTime @default(now())

  @@map("registros_treino")
}
